# Copy this file to .env.local and fill it in. SETUP.md explains where each value comes from.

# --- Firebase web app (Project settings > General > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL (Build > Realtime Database, shown at the top of the Data tab)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Firebase service account (Project settings > Service accounts > Generate new private key) ---
# Server only. Never commit these or prefix them with NEXT_PUBLIC_.
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the \n characters.
FIREBASE_PRIVATE_KEY=

# --- OpenRouteService (truck routing, distance and ETA). Free key from openrouteservice.org ---
# Optional: without it the app falls back to the public OSRM demo server.
ORS_API_KEY=
