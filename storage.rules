rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // PDF, JPG or PNG, up to 10 MB.
    function validFile() {
      return request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png');
    }

    function isTripParty(tripId) {
      let trip = firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      return trip.ownerId == request.auth.uid || trip.driverId == request.auth.uid;
    }

    // Driver license and face photo: only that driver.
    match /drivers/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && validFile();
    }

    // Vehicle documents (RC, insurance, PUC and so on): only the owner. Files are never replaced or deleted.
    match /vehicles/{uid}/{vehicleId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && validFile();
    }

    // Trip documents: the trip's owner and its assigned driver. Files are never replaced or deleted.
    match /trips/{tripId}/{fileName} {
      allow read: if request.auth != null && isTripParty(tripId);
      allow create: if request.auth != null && isTripParty(tripId) && validFile();
    }
  }
}
